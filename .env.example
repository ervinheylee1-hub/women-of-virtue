# Women of Virtue - Environment Configuration
# Copy this file to .env to configure your local or production environment variables.

# Resend Email Integration (https://resend.com)
# 1. Sign up for free at resend.com
# 2. Generate an API Key under https://resend.com/api-keys
# 3. Paste the key below:
RESEND_API_KEY=re_your_api_key_here

# The recipient inbox where you want form submissions delivered:
TARGET_EMAIL=heylee@absolutionuecna.org

# The sender identity (From header):
# Note: For free testing before verifying your domain, use "Women of Virtue <onboarding@resend.dev>"
# Once your domain (women-of-virtue.com) is verified in Resend, you can use e.g. "Women of Virtue <contact@women-of-virtue.com>"
RESEND_FROM_EMAIL=Women of Virtue <onboarding@resend.dev>

# CMS Server Port (optional, default 5173)
PORT=5173
